A modern replacement for ls

Usage: eza [OPTIONS] [FILE]...

META OPTIONS:
      --stdin    read file names from stdin
  -?, --help     Print help
      --version  Print version

LAYOUT OPTIONS:
  -1, --oneline          display one entry per line
  -l, --long             display extended file metadata as a table
  -g, --long-no-owner    like -l, but list the group instead of the owner
  -o, --long-no-group    like -l, but do not list the group
      --grid             display entries as a grid (default)
  -C, --format-columns   display entries as a grid, listed down columns
  -x, --across           display entries as a grid, listed across rows
  -R, --recurse          recurse into directories [alias: --recursive]
      --tree             recurse into directories as a tree
      --level <DEPTH>    limit the depth of recursion
      --code[=<MODE>]    summarise lines of code by language, recursing the tree or git repo
      --follow-symlinks  drill down into symbolic links that point to directories
  -w, --width <COLS>     set screen width in columns, 0 means no limit

DISPLAY OPTIONS:
  -F                               display type indicator by file names (same as --classify=always)
      --classify[=<WHEN>]          display type indicator by file names [possible values: always, auto, never]
  -L, --dereference                dereference symbolic links when displaying information
      --absolute [<absolute>]      display entries with their absolute path [possible values: on, off, follow]
      --color [<WHEN>]             When to use colours. [default: auto] [possible values: always, auto, never]
      --color-scale [<FIELDS>...]  highlight value of FIELDS distinctly [possible values: all, age, size]
      --color-scale-mode <MODE>    mode for --color-scale [default: gradient] [possible values: fixed, gradient]
      --icons [<WHEN>]             when to display icons [possible values: always, auto, never]
      --hyperlink [<WHEN>]         when to display entries as hyperlinks [possible values: always, auto, never]
      --no-quotes                  don't quote file names with spaces
      --short-nix                  abbreviate Nix store hashes in file names and paths

FILTERING OPTIONS:
  -a, --all...               show hidden files and the '.' and '..' directories
  -f, --unsorted-all         like -a, and do not sort
  -A, --almost-all           show hidden files, but not '.' and '..'
  -d, --treat-dirs-as-files  treat directories as files; don't list their contents [alias: --directory]
      --only-dirs            list only directories
      --only-files           list only files
      --show-symlinks        explicitly show symbolic links (with --only-dirs and --only-files)
      --no-symlinks          do not show symbolic links
  -B, --ignore-backups       do not list entries ending with ~
  -I, --ignore-glob <GLOBS>  glob patterns (pipe-separated) of files to ignore [alias: --ignore]
      --git-ignore           ignore files mentioned in '.gitignore'

SORTING OPTIONS:
      --group-directories-first  list directories before other files
      --group-directories-last   list directories after other files
  -t, --sort-time                sort by time, newest first (see --time, -c, -u)
  -S, --sort-size                sort by file size, largest first
  -U, --unsorted                 do not sort; list entries in directory order
  -X, --sort-extension           sort alphabetically by entry extension
  -v, --sort-version             natural sort of (version) numbers within names
  -c, --ctime                    with -t: sort by changed time; with -l: show it; otherwise: sort by it
  -u, --atime                    with -t: sort by accessed time; with -l: show it; otherwise: sort by it
      --sort <FIELD>             which field to sort by [default: name] [possible values:
                                   name, Name, .name, .Name, ext, Ext, extension, version, created,
                                   date, age, accessed, changed, time (newest first),
                                   size (largest first), inode, type, none]
  -r, --reverse                  reverse the sort order

LONG VIEW OPTIONS:
      --header               add a header row to each column
  -i, --inode                list each file's inode number
      --loc[=<MODE>]         add lines-of-code and language columns [modes: lines, percent, both]
      --octal-permissions    list each file's permission in octal format
      --links                list each file's number of hard links
  -h, --human-readable       show file sizes with binary prefixes (same as --binary)
      --binary               show file sizes with binary prefixes
      --bytes                show file sizes in bytes, without any prefixes
      --total-size           show the size of a directory as the one of its content (unix only)
  -s, --size                 list size of allocated file system blocks (same as --blocksize)
      --blocksize            list size of allocated file system blocks
      --group                list each file's group
  -G, --no-group             do not list the group (overrides -g, --group)
      --smart-group          only show group if it has a different name from owner
  -n, --numeric-uid-gid      like -l, but show user and group as their numeric IDs
      --numeric              show user and group as their numeric IDs
      --time <FIELD>         which timestamp field to show and sort by [possible values:
                               mod|modified|mtime, acc|accessed|atime|access|use,
                               ch|changed|ctime|status, cr|created|birth|creation]
      --modified             show the modified timestamp field (replace default field, combinable)
      --accessed             show the accessed timestamp field (replace default field, combinable)
      --changed              show the changed timestamp field (replace default field, combinable)
      --created              show the created timestamp field (replace default field, combinable)
      --time-style <STYLE>   how to format timestamps [possible values:
                               default, iso, long-iso, full-iso, relative, "+<CUSTOM_FORMAT>"]
  -O, --flags                list file flags (Mac, BSD, and Windows only)
  -Z, --context              list each file's security context
      --git                  list each file's Git status, if tracked or ignored
      --git-repos            list root of git-tree status
      --git-repos-no-status  list each git-repos branch name (much faster)
  -M, --mounts               show mount details (Linux and macOS only)
  -@, --extended             list each file's extended attributes and sizes
      --no-permissions       suppress the permissions field
      --no-filesize          suppress the filesize field
      --no-user              suppress the user field
      --no-time              suppress the time field
      --no-git               suppress Git fields (overrides --git, --git-repos, --git-repos-no-status)
